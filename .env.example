# Public Supabase browser configuration.
# Use the anon/public key only. Never put a service-role or secret key in a VITE_* variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLIC_KEY

# Optional: enables Google Places address autocomplete in checkout.
# Restrict this key to your Netlify domain in Google Cloud Console.
# VITE_GOOGLE_MAPS_API_KEY=